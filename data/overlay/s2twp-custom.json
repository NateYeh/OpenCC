{
  "name": "Simplified Chinese to Traditional Chinese (Taiwan standard, with phrases) + NateYeh overlay",
  "segmentation": {
    "type": "mmseg",
    "dict": {
      "type": "group",
      "match_policy": "short_circuit",
      "dicts": [
        { "type": "text", "file": "s2twp-overlay-phrases.txt" },
        { "type": "ocd2", "file": "STPhrases.ocd2" }
      ]
    }
  },
  "conversion_chain": [
    {
      "dict": {
        "type": "group",
        "match_policy": "short_circuit",
        "dicts": [
          { "type": "text", "file": "s2twp-overlay-phrases.txt" },
          { "type": "ocd2", "file": "STPhrases.ocd2" },
          { "type": "text", "file": "s2twp-overlay-chars.txt" },
          { "type": "ocd2", "file": "STCharacters.ocd2" }
        ]
      }
    },
    {
      "dict": {
        "type": "group",
        "match_policy": "short_circuit",
        "dicts": [
          { "type": "text", "file": "s2twp-overlay-tw.txt" },
          { "type": "ocd2", "file": "TWPhrases.ocd2" }
        ]
      }
    },
    {
      "dict": { "type": "ocd2", "file": "TWVariants.ocd2" }
    }
  ]
}
